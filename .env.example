# ============================================================================
#  Bot Añelo (SEA WHITE S.A.) — variables de entorno
#  Copiá este archivo como .env para trabajar en local. NUNCA subas el .env.
#  Este bot es INDEPENDIENTE de Enri: no reutilices su WEBHOOK_SECRET, su
#  proyecto de Supabase ni su servicio de Render.
# ============================================================================

# --- General ---
BOT_NAME=Javier
# Imagen del saludo a los choferes. Si el archivo no existe, el saludo sale sólo con texto.
WELCOME_IMAGE=assets/javier.jpg
PORT=3000
LOG_LEVEL=info
TIMEZONE=America/Argentina/Buenos_Aires

# --- Claude (separación de carnets) ---
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=high
CLAUDE_FALLBACKS=true

# --- API de SEA WHITE (mismo usuario que Enri, confirmado por el ingeniero) ---
SEALINK_BASE_URL=https://api.seawhite.com.ar:9443
SEALINK_EMAIL=
SEALINK_PASSWORD=
SEALINK_SERVIDOR=1
# Interruptor general de la CARGA. Mientras esté en false, ningún POST sale a la red.
ANELO_CARGA_HABILITADA=false
# Modo prueba: sólo se puede cargar en clientes de prueba 9999xx (no hay ambiente de prueba en SEA WHITE).
ANELO_MODO_PRUEBA=true
ANELO_PREFIJO_PRUEBA=9999

# --- Chatwoot ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=182533
# Inbox de ESTE bot (+54 9 291 571-9564). OBLIGATORIO: sin esto contestaría los chats de Enri.
CHATWOOT_INBOX_ID=146313
# Token propio (distinto del de Enri); va en la URL del webhook: ?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=

# --- Supabase (proyecto PROPIO de este bot, no el de Enri) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel web (/panel). Vacío = panel apagado ---
ADMIN_PASSWORD=
