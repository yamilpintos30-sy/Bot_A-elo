{
  "name": "seawhite-bot-anelo",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp de Vencimientos Añelo (SEA WHITE S.A.): carga de credenciales con separación automática de carnets y consulta de vencimientos. Independiente del bot Enri.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "extraer": "tsx src/cli/extraer.ts",
    "verificar": "tsx src/cli/verificarSeaWhite.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@napi-rs/canvas": "0.1.80",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
